+
+# --------------------------------------------------- typed relation injection
+#
+# LightRAG's own schema has no relation type. Its extraction prompt asks for a
+# `relationship_description` -- "explanation as to why you think the source
+# entity and the target entity are related" -- and a `relationship_keywords`
+# field told to report "concepts or themes rather than specific details". So the
+# predicate is not stored anywhere: measured on ten HotpotQA passages, 0 of 31
+# edges whose entity pair matched our extraction carried a relation that could
+# be compared with the extracted predicate, because what the edge carries is an
+# 18-word sentence.
+#
+# That is fatal for measuring a defence that perturbs predicates. The loss falls
+# equally on the undefended and the sanitised corpus, and it makes the attacker
+# recover less in both -- which flatters the defence, the one direction an
+# evaluation must not be biased in.
+#
+# Asking the LLM for the predicate was tried first and is not enough: adding a
+# field and rewriting the few-shot examples took the description from 16 words
+# to 9 and the exact agreement with our extracted predicate from 0% to 41%, but
+# 41% is not a guarantee and a graph built by a second extractor can always
+# disagree with the first.
+#
+# So the predicates are not extracted here at all. They are injected from the
+# pipeline that wrote them into the text: dp/inplace.py knows the exact
+# (subject, predicate, object) it substituted into each passage, so the graph is
+# handed that triple and carries the predicate verbatim. The guarantee is
+# structural rather than statistical.
+#
+# LightRAG's own extraction is left completely alone -- same prompt, same
+# gleaning, same entities, same descriptions. This adds a channel; it removes
+# nothing. A pair LightRAG found and we did not keeps an empty type.
+INJECT_ENV = "DP_TYPED_RELATIONS"
+
+
+def _load_injected_relations() -> dict:
+    """title -> [(subject, predicate, object)], from the file DP_TYPED_RELATIONS names."""
+    path = os.environ.get(INJECT_ENV, "").strip()
+    if not path:
+        return {}
+    if not os.path.exists(path):
+        raise FileNotFoundError(f"{INJECT_ENV}={path} does not exist")
+    with open(path, encoding="utf-8") as handle:
+        raw = json.load(handle)
+    out = {}
+    for title, triples in raw.get("by_title", {}).items():
+        out[title] = [(t["subject"], t["relation"], t["object"]) for t in triples]
+    logger.info(f"typed relations: {sum(len(v) for v in out.values())} triples "
+                f"over {len(out)} passages from {path}")
+    return out
+
+
+def _injected_edges_for_chunk(content: str, chunk_key: str,
+                              injected: dict) -> list:
+    """The typed edges whose passage this chunk contains.
+
+    A chunk may hold several passages, because benchmarks.pack() concatenates
+    them up to a token budget. Membership is decided by the passage title
+    appearing in the chunk, which is how the corpus is built: the title is the
+    passage's first line and it is carried into the index verbatim.
+
+    Entity names are upper-cased to match _handle_single_entity_extraction,
+    which does `clean_str(record_attributes[1].upper())`. An endpoint LightRAG
+    never extracted is not a problem: _merge_edges_then_upsert creates a missing
+    node rather than dropping the edge.
+    """
+    out = []
+    for title, triples in injected.items():
+        if title not in content:
+            continue
+        for subject, relation, obj in triples:
+            s, o = clean_str(subject.upper()), clean_str(obj.upper())
+            if not s or not o or s == o:
+                continue
+            spoken = relation.replace("_", " ")
+            out.append(dict(
+                src_id=s, tgt_id=o, weight=1.0,
+                # the description says the triple and nothing else, so a reader
+                # handed this edge sees the predicate rather than a paraphrase
+                description=f"{subject} {spoken} {obj}",
+                keywords=spoken,
+                relation_type=relation,
+                source_id=chunk_key))
+    return out
+
