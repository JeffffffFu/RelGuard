# Copy this file to .env and fill it in. .env is gitignored and is the only
# place a key lives; nothing in the repository reads one from anywhere else.

# Every model in the pipeline is a hosted, closed model reached through the
# OpenAI client: gpt-4o-mini (extraction, the victims' reader, the attacker,
# the judge), gpt-5-mini (the candidate pools), and optionally other readers
# such as gemini-2.5-flash. One key and one endpoint serve all of them.

# Option A: the OpenAI API directly. Leave OPENAI_BASE_URL unset.
OPENAI_API_KEY=sk-...

# Option B: an OpenAI-compatible gateway such as OpenRouter, which also serves
# the non-OpenAI readers. Use its key and point the client at it; model ids
# then follow the gateway's naming (e.g. google/gemini-2.5-flash).
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
